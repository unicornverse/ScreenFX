{
  "manifest_version": 3,
  "name": "Screenick",
  "version": "2.0.0",
  "description": "Click when bored. Twelve full-screen visual pranks for whatever tab you are on, on demand or on a timer.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screenick \u2014 pick a prank",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "surprise-me": {
      "description": "Play a random Screenick effect on this tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
